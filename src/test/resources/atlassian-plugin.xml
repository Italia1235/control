<atlassian-plugin key="${project.groupId}.${project.artifactId}-tests" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
    </plugin-info>

    <!-- from our base plugin -->
    <component-import key="fieldScreenService" interface="ru.rasulov.customfields.api.FieldScreenService"/>
    <component-import key="customFieldCreator" interface="ru.rasulov.customfields.api.CustomFieldCreator"/>
    <component-import key="lookupService" interface="ru.rasulov.common.api.LookupService"/>
    <component-import key="workflowConfigurer" interface="ru.rasulov.workflow.api.WorkflowConfigurer"/>
    <component-import key="workflowAssigner" interface="ru.rasulov.workflow.api.WorkflowAssigner"/>
    <component-import key="workflowCloner" interface="ru.rasulov.workflow.api.WorkflowCloner"/>
    <component-import key="workflowDraftPublisher" interface="ru.rasulov.workflow.api.WorkflowDraftPublisher"/>
    <component-import key="workflowEditor" interface="ru.rasulov.workflow.api.WorkflowEditor"/>
    <component-import key="workflowReader" interface="ru.rasulov.workflow.api.WorkflowReader"/>

    <!-- from the product container -->
    <component-import key="customFieldManager" interface="com.atlassian.jira.issue.CustomFieldManager"/>
    <component-import key="jiraAuthenticationContext" interface="com.atlassian.jira.security.JiraAuthenticationContext"/>
    <component-import key="optionsManager" interface="com.atlassian.jira.issue.customfields.manager.OptionsManager"/>
    <component-import key="userManager" interface="com.atlassian.jira.user.util.UserManager"/>
    <component-import key="projectService" interface="com.atlassian.jira.bc.project.ProjectService"/>
    <component-import key="projectManager" interface="com.atlassian.jira.project.ProjectManager"/>
    <component-import key="issueTypeManager" interface="com.atlassian.jira.config.IssueTypeManager"/>
    <component-import key="fieldScreenManager" interface="com.atlassian.jira.issue.fields.screen.FieldScreenManager"/>
    <component-import key="issueTypeScreenSchemeManager" interface="com.atlassian.jira.issue.fields.screen.issuetype.IssueTypeScreenSchemeManager"/>
    <component-import key="issueTypeSchemeManager" interface="com.atlassian.jira.issue.fields.config.manager.IssueTypeSchemeManager"/>
    <component-import key="workflowManager" interface="com.atlassian.jira.workflow.WorkflowManager"/>
    <component-import key="workflowSchemeManager" interface="com.atlassian.jira.workflow.WorkflowSchemeManager"/>
    <component-import key="workflowSchemeService" interface="com.atlassian.jira.bc.workflow.WorkflowSchemeService"/>
    <component-import key="issueWorkflowManager" interface="com.atlassian.jira.workflow.IssueWorkflowManager"/>
    <component-import key="issueService" interface="com.atlassian.jira.bc.issue.IssueService"/>
    <component-import key="issueManager" interface="com.atlassian.jira.issue.IssueManager"/>
    <component-import key="statusManager" interface="com.atlassian.jira.config.StatusManager"/>
    <component-import key="statusService" interface="com.atlassian.jira.bc.config.StatusService"/>
    <component-import key="ofBizDelegator" interface="com.atlassian.jira.ofbiz.OfBizDelegator"/>

</atlassian-plugin>
